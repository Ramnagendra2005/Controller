# ── Python ──────────────────────────────────────────────
# Virtual environment (recreate with: python -m venv .venv)
.venv/
venv/
__pycache__/
*.py[cod]

# ── Secrets / machine-specific ──────────────────────────
# Self-signed HTTPS cert + PRIVATE KEY, auto-generated by server.py's
# ensure_cert() for this PC's IPs. Never commit a private key.
certs/

# ── Third-party binaries ────────────────────────────────
# Android platform-tools (adb.exe etc.) — download from Google;
# server.py falls back to `adb` on PATH if this folder is missing.
tools/platform-tools/

# ── OS / editor clutter ─────────────────────────────────
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/
*.log
